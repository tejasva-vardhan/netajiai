# Copy to .env for the Docker Compose local profile. The generated local
# secrets in .env should be replaced before any shared or deployed use.
APP_ENV=development
SERVICE_NAME=aineta-api
COMPOSITION_MODULE=backend.app.composition
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://postgres:<local-password>@postgres:5432/aineta

AI_PROVIDER=mistral
AI_MODEL=mistral-small-latest
MISTRAL_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_ENDPOINT=https://api.deepgram.com/v1/listen
AI_MONTHLY_REQUEST_LIMIT=1000
VOICE_MONTHLY_REQUEST_LIMIT=250

# Temporary local account verification. Switch to the approved DigiLocker
# Requester values only after government onboarding is complete.
DIGILOCKER_MODE=temporary
IDENTITY_PROVIDER=temporary
DIGILOCKER_CLIENT_ID=aineta-local
DIGILOCKER_AUTHORIZATION_ENDPOINT=http://localhost:8001/api/v1/identity/temporary/authorize
DIGILOCKER_REDIRECT_URI=http://localhost:8001/api/v1/identity/digilocker/callback
DIGILOCKER_SCOPE=openid
DIGILOCKER_PURPOSE=verification
IDENTITY_STATE_ENCRYPTION_KEY=<fernet-key>
PUBLIC_TRACKING_TOKEN_SECRET=<32-byte-secret>
ISSUE_CLUSTER_HMAC_KEY=<32-byte-secret>

OIDC_ISSUER=http://localhost:8080/realms/aineta
OIDC_JWKS_URL=http://keycloak:8080/realms/aineta/protocol/openid-connect/certs
OIDC_AUDIENCE=aineta-api
OIDC_ALGORITHMS=RS256
OIDC_IDENTITY_VERIFIED_CLAIM=identity_verified
TEMPORAL_TARGET=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ai-neta-complaints
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=complaint.lifecycle.v1
KAFKA_CONSUMER_GROUP=aineta-workflows
EVENT_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_ERROR_BACKOFF_SECONDS=10
EVIDENCE_CLEANUP_BATCH_SIZE=100
EVIDENCE_CLEANUP_INTERVAL_SECONDS=300
EVIDENCE_CLEANUP_AGE_SECONDS=86400
EVIDENCE_CLEANUP_RETRY_AFTER_SECONDS=900
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=aineta-evidence
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PRESIGN_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=aineta-local
AWS_SECRET_ACCESS_KEY=<minio-password>
REDIS_URL=redis://redis:6379/0
CAPTURE_ATTESTATION_MODE=local
WEB_CAPTURE_ENABLED=true
WEB_CAPTURE_SESSION_HMAC_KEY=<32-byte-secret>
WEB_CAPTURE_SESSION_TTL_SECONDS=300
WEB_CAPTURE_REVIEW_REQUIRED=true
MEDIA_INSPECTOR_MODE=local

# Intentionally deferred in this local profile.
OTEL_ENABLED=false
OTEL_EXPORTER=none
OTEL_SAMPLE_RATIO=1.0

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<local-password>
POSTGRES_DB=aineta
MINIO_ROOT_USER=aineta-local
MINIO_ROOT_PASSWORD=<minio-password>
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<keycloak-password>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8080/realms/aineta
NEXT_PUBLIC_OIDC_CLIENT_ID=aineta-web
NEXT_PUBLIC_OIDC_SCOPES="openid profile"
NEXT_PUBLIC_OIDC_ADMIN_REDIRECT_URI=http://localhost:3000/admin/auth/callback
NEXT_PUBLIC_OIDC_ADMIN_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
NEXT_PUBLIC_OIDC_CITIZEN_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_OIDC_CITIZEN_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
